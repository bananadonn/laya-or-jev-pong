# TypeSafe (Jev) hosted API key — https://console.typesafe.ai
# Required for src/decisions/jevClient.ts. Never commit the real value.
TYPESAFE_API_KEY=

# Port the local Laya inference server (server/laya_server.py) listens on.
LAYA_PORT=8787

# Same port, re-exposed to the browser bundle (Vite only ships VITE_-prefixed
# vars to client code) so layaClient.ts knows where to reach it. Keep these two in sync.
VITE_LAYA_PORT=8787

# Optional: override the Jev model id (defaults to jev-latest).
JEV_MODEL=jev-latest
